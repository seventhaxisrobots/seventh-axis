{
  "name": "seventh-axis",
  "private": true,
  "version": "0.1.0",
  "description": "Program robot arms in plain English, Bahasa Malaysia or Mandarin.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "waitlist:export": "node scripts/export-waitlist.mjs",
    "bridge": "node --experimental-strip-types bridge/src/cli.ts",
    "ursim": "docker run -d --rm --name ursim -e ROBOT_MODEL=UR10 -p 6080:6080 -p 29999:29999 -p 30001-30004:30001-30004 universalrobots/ursim_e-series"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.12.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
