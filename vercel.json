{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/investors",
      "destination": "/about#investors",
      "permanent": true
    },
    {
      "source": "/studio",
      "destination": "https://seventh-axis-studio.vercel.app/studio",
      "permanent": false
    },
    {
      "source": "/studio.html",
      "destination": "https://seventh-axis-studio.vercel.app/studio",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "https://seventh-axis-studio.vercel.app/app",
      "permanent": false
    },
    {
      "source": "/app.html",
      "destination": "https://seventh-axis-studio.vercel.app/app",
      "permanent": false
    }
  ]
}
