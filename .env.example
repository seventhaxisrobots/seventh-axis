# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.8-flash, falling back to gemini-flash-latest.
GEMINI_MODEL=

# Waitlist storage (Upstash Redis). Adding the "Upstash for Redis" integration
# from the Vercel Marketplace fills these in automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
